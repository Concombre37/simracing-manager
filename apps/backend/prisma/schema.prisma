generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                   String   @id @default("singleton")
  blankingDelaySeconds Int      @default(10) @map("blanking_delay_seconds")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  role      String   @default("technician")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKeys     ApiKey[]
  raceFormats RaceFormat[]

  @@map("users")
}

model Station {
  id          String    @id @default(uuid()) @db.Uuid
  stationId   String    @unique @map("station_id")
  name        String
  role        String    @default("simulator")
  apiKeyHash  String?   @map("api_key_hash")
  version     String?
  localIp     String?   @map("local_ip")
  macAddress  String?   @map("mac_address")
  lastSeenAt  DateTime? @map("last_seen_at")
  status      String    @default("offline")
  blankingActive Boolean @default(true) @map("blanking_active")
  config      Json?
  content     Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  dedicatedServers DedicatedServer[]
  contentPreviews ContentPreview[]
  blankingMedia   BlankingMedia[]

  @@map("stations")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  stationId       String    @map("station_id") @db.Uuid
  type            String    @default("direct_launch") @map("type")
  serverId        String?   @map("server_id") @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  clientName      String?   @map("client_name")
  difficulty      String?   @map("difficulty")
  gearbox         String?   @map("gearbox")
  carAcId         String?   @map("car_ac_id")
  track           String?
  trackLayout     String?   @map("track_layout")
  durationMinutes Int?      @map("duration_minutes")
  config          Json
  status          String    @default("pending")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  result          Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  telemetryFiles TelemetryFile[]

  @@map("sessions")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@unique([name])
  @@map("clients")
}

model TelemetryFile {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  fileName  String   @map("file_name")
  sizeBytes Int      @map("size_bytes")
  content   Bytes?
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("telemetry_files")
}

model ContentPackage {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  name        String
  version     String
  archiveUrl  String   @map("archive_url")
  checksum    String?
  isRequired  Boolean  @default(true) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, name, version])
  @@map("content_packages")
}

model DedicatedServer {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  stationId      String      @map("station_id") @db.Uuid
  station        Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)
  track          String
  trackLayout    String?     @map("track_layout")
  cars           String[]
  maxClients     Int         @default(10) @map("max_clients")
  password       String?
  rconPassword   String?     @map("rcon_password")
  config         Json?
  status         String      @default("stopped")
  serverDir      String?     @map("server_dir")
  udpPort        Int?        @map("udp_port")
  tcpPort        Int?        @map("tcp_port")
  httpPort       Int?        @map("http_port")
  raceFormatId   String?     @map("race_format_id") @db.Uuid
  raceFormat     RaceFormat? @relation(fields: [raceFormatId], references: [id], onDelete: SetNull)
  startedAt      DateTime?   @map("started_at")
  endedAt        DateTime?   @map("ended_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("dedicated_servers")
}

// Reusable Practice/Qualifying/Race preset for dedicated servers — created
// once from the "Formats de course" admin page, then picked by id when
// creating a server. Resolved server-side into `RaceFormatConfig` (shared
// package) and sent to the agent as plain values; the agent never queries
// this table itself.
model RaceFormat {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  practiceEnabled   Boolean  @default(true) @map("practice_enabled")
  practiceMinutes   Int      @default(720) @map("practice_minutes")
  qualifyingEnabled Boolean  @default(false) @map("qualifying_enabled")
  qualifyingMinutes Int      @default(15) @map("qualifying_minutes")
  raceEnabled       Boolean  @default(false) @map("race_enabled")
  // RaceMode ('LAPS'|'TIME') — plain String, same convention as every other
  // enum-like column in this schema (validated app-side via @simracing/shared).
  raceMode          String   @default("LAPS") @map("race_mode")
  raceLaps          Int      @default(5) @map("race_laps")
  raceMinutes       Int      @default(20) @map("race_minutes")
  // GridType — same String convention as raceMode above.
  gridType          String   @default("NORMAL") @map("grid_type")
  weatherGraphics   String[] @map("weather_graphics")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  dedicatedServers DedicatedServer[]

  @@map("race_formats")
}

model ContentPreview {
  id        String   @id @default(uuid()) @db.Uuid
  stationId String   @map("station_id") @db.Uuid
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type      String
  acId      String   @map("ac_id")
  name      String
  data      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stationId, type, acId])
  @@map("content_previews")
}

model ContentLabel {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  acId        String   @map("ac_id")
  displayName String   @map("display_name")
  // Tag libre (ex: "GT3", "Rallye") et difficulté 1-5 — utilisés par la
  // page tablette (/tablet-menu), pas de valeur inventée : null tant que
  // l'admin n'a rien renseigné.
  category    String?
  difficulty  Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, acId])
  @@map("content_labels")
}

// Carte resto/bar affichée sur la page tablette publique (/tablet-menu),
// gérée par les admins via /restaurant-menu — voir ExternalApiController.
model MenuCategory {
  id        String     @id @default(uuid()) @db.Uuid
  section   String // 'food' | 'drinks'
  title     String
  subtitle  String?
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @default(uuid()) @db.Uuid
  categoryId  String       @map("category_id") @db.Uuid
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Texte libre ("9,50 €") — juste affiché sur la tablette, pas de calcul.
  price       String
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("menu_items")
}

model BlankingMedia {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null = global media (shared by every pod — used by "launching" and
  /// "results", which look identical everywhere). Non-null = per-station
  /// media (used by "idle", which can reasonably differ per pod).
  stationId String?  @map("station_id") @db.Uuid
  station   Station? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  category  String   @default("idle")
  filename  String
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  data      Bytes    @db.ByteA
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stationId, category, order])
  @@map("blanking_media")
}

/// Clés d'accès en lecture seule pour des consommateurs externes (site web,
/// bot Discord, etc.) — distinctes des clés station (agent) et du JWT
/// utilisateur (dashboard). Le hash suit la même convention que
/// Station.apiKeyHash (SHA-256 en clair, jamais le secret en base).
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash")
  /// Préfixe affiché dans le dashboard pour identifier la clé sans jamais
  /// pouvoir reconstituer le secret complet.
  keyPrefix   String    @map("key_prefix")
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}
